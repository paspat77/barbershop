/* pages/index/index.wxss */
.top-notice-banner {
  background: #1c1917;
  color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #059669;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}

.notice-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #292524;
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
}

.notice-badge {
  background: #10b981;
  color: #fff;
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 32rpx;
  font-size: 20rpx;
  margin-right: 12rpx;
}

.notice-title {
  color: #34d399;
  font-size: 24rpx;
  font-weight: bold;
  flex: 1;
}

.notice-close {
  color: #a8a29e;
  font-size: 26rpx;
  padding: 0 10rpx;
}

.notice-line {
  font-size: 26rpx;
  font-weight: bold;
  display: block;
}

.notice-sub {
  font-size: 22rpx;
  color: #d6d3d1;
  display: block;
  margin-top: 6rpx;
}

.notice-code {
  font-size: 22rpx;
  color: #fde68a;
  display: block;
  margin-top: 6rpx;
  font-family: monospace;
}

.shop-card {
  background: #292524;
  color: #fff;
}

.shop-title {
  font-size: 34rpx;
  font-weight: bold;
}

.shop-desc {
  font-size: 22rpx;
  color: #a8a29e;
  margin-top: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.legend-note {
  font-size: 22rpx;
  color: #78716c;
}

.stylist-list {
  display: flex;
  gap: 16rpx;
}

.stylist-item {
  flex: 1;
  border: 2rpx solid #e7e5e4;
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  background: #fff;
}

.stylist-item.active {
  border-color: #b45309;
  background: #fffbeb;
}

.stylist-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #78350f;
  color: #fff;
  line-height: 64rpx;
  margin: 0 auto 10rpx;
  font-weight: bold;
  font-size: 28rpx;
}

.stylist-name {
  font-size: 24rpx;
  font-weight: bold;
}

.stylist-title {
  font-size: 20rpx;
  color: #78350f;
  margin-top: 4rpx;
}

.stylist-exp {
  font-size: 18rpx;
  color: #78716c;
}

.date-scroll {
  display: flex;
  white-space: nowrap;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f5f5f4;
  border-radius: 16rpx;
  margin-right: 14rpx;
  min-width: 90rpx;
}

.date-item.active {
  background: #78350f;
  color: #fff;
}

.date-rel {
  font-size: 20rpx;
}

.date-num {
  font-size: 32rpx;
  font-weight: bold;
  margin: 4rpx 0;
}

.date-week {
  font-size: 20rpx;
}

.service-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.service-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1rpx solid #e7e5e4;
  border-radius: 16rpx;
  padding: 18rpx;
}

.service-item.active {
  border-color: #b45309;
  background: #fffbeb;
}

.service-name {
  font-size: 26rpx;
  font-weight: bold;
  display: block;
}

.service-duration {
  font-size: 20rpx;
  color: #78716c;
}

.service-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #78350f;
}

.slot-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.slot-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 14rpx;
  border: 1rpx solid #d6d3d1;
  background: #fff;
}

.slot-btn.available {
  border-color: #6ee7b7;
  color: #065f46;
}

.slot-btn.unavailable {
  background: #f5f5f4;
  color: #a8a29e;
  border-color: #e7e5e4;
}

.slot-btn.booked {
  background: #f5f5f4;
  color: #78716c;
  border-color: #e7e5e4;
}

.slot-btn.selected {
  background: #059669;
  color: #fff;
  border-color: #059669;
}

.slot-time {
  font-size: 24rpx;
  font-weight: bold;
}

.slot-label {
  font-size: 18rpx;
}

.booking-action-card {
  border: 2rpx solid #b45309;
}

.summary-box {
  font-size: 24rpx;
  font-weight: bold;
  color: #78350f;
  margin-bottom: 16rpx;
}

.input-group {
  margin-bottom: 16rpx;
}

.input {
  border: 1rpx solid #d6d3d1;
  background: #fafaf9;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.submit-btn {
  width: 100%;
  margin-top: 10rpx;
}
