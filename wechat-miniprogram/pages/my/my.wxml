<!--pages/my/my.wxml-->
<view class="container">
  <view class="card user-card">
    <view class="user-name">预约中心与服务通知记录</view>
    <view class="user-sub">可在此查看预约核销码，或取消预约释放时段</view>
  </view>

  <view wx:if="{{appointments.length === 0}}" class="card empty-card">
    <text class="empty-text">暂无预约记录</text>
  </view>

  <view wx:else class="appt-list">
    <view wx:for="{{appointments}}" wx:key="id" class="card appt-card">
      <view class="appt-header">
        <text class="appt-title">{{item.serviceName}}</text>
        <text class="appt-status {{item.status}}">{{item.status === 'confirmed' ? '已预约·待服务' : '已取消'}}</text>
      </view>

      <view class="code-box" wx:if="{{item.status === 'confirmed'}}">
        <text class="code-label">到店核销码：</text>
        <text class="code-val">#{{item.bookingCode}}</text>
      </view>

      <view class="appt-info">
        <view class="info-row">
          <text class="label">发型师：</text>
          <text class="val">{{item.stylistName}}</text>
        </view>
        <view class="info-row">
          <text class="label">预约时间：</text>
          <text class="val font-mono">{{item.date}} {{item.timeSlot}}</text>
        </view>
        <view class="info-row">
          <text class="label">到店费用：</text>
          <text class="val price">¥{{item.servicePrice}}</text>
        </view>
      </view>

      <!-- 微信服务通知状态 -->
      <view class="notice-badge-box">
        <text class="dot">✓</text>
        <text class="notice-tip">微信服务通知已推送至微信服务号，并已归档</text>
      </view>

      <view class="appt-action" wx:if="{{item.status === 'confirmed'}}">
        <button size="mini" type="warn" plain bindtap="cancelAppt" data-id="{{item.id}}">取消预约</button>
      </view>
    </view>
  </view>
</view>
