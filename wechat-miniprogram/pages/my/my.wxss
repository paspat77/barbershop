/* pages/my/my.wxss */
.user-card {
  background: #1c1917;
  color: #fff;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
}

.user-sub {
  font-size: 22rpx;
  color: #a8a29e;
  margin-top: 8rpx;
}

.empty-card {
  text-align: center;
  padding: 80rpx 0;
  color: #a8a29e;
}

.appt-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.appt-card {
  border: 1rpx solid #e7e5e4;
}

.appt-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f4;
  padding-bottom: 14rpx;
  margin-bottom: 14rpx;
}

.appt-title {
  font-size: 28rpx;
  font-weight: bold;
}

.appt-status.confirmed {
  color: #059669;
  font-size: 22rpx;
  background: #ecfdf5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.appt-status.cancelled {
  color: #78716c;
  font-size: 22rpx;
  background: #f5f5f4;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.code-box {
  background: #fafaf9;
  border: 1rpx dashed #d6d3d1;
  border-radius: 12rpx;
  padding: 14rpx;
  margin-bottom: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.code-label {
  font-size: 22rpx;
  color: #78716c;
}

.code-val {
  font-size: 32rpx;
  font-weight: bold;
  font-family: monospace;
  color: #78350f;
}

.info-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.info-row .label {
  color: #78716c;
}

.info-row .price {
  font-weight: bold;
  color: #78350f;
}

.notice-badge-box {
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
  border-radius: 10rpx;
  padding: 10rpx 14rpx;
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.notice-badge-box .dot {
  background: #10b981;
  color: #fff;
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  text-align: center;
  line-height: 24rpx;
  font-size: 16rpx;
}

.notice-tip {
  font-size: 20rpx;
  color: #065f46;
}

.appt-action {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f5f5f4;
}
