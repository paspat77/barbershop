/* pages/schedule/schedule.wxss */
.barber-header {
  background: #1c1917;
  color: #fff;
  border: 1rpx solid #44403c;
}

.barber-profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.barber-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 20rpx;
  background: #78350f;
  color: #fff;
  line-height: 90rpx;
  text-align: center;
  font-weight: bold;
  font-size: 36rpx;
  border: 2rpx solid #d97706;
}

.barber-details {
  flex: 1;
}

.barber-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.barber-name {
  font-size: 32rpx;
  font-weight: bold;
}

.barber-role {
  font-size: 20rpx;
  background: #451a03;
  color: #fde68a;
  border: 1rpx solid #b45309;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.barber-exp {
  font-size: 22rpx;
  color: #d6d3d1;
  margin-top: 6rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.date-selected-hint {
  font-size: 22rpx;
  color: #b45309;
  font-weight: bold;
}

/* Horizontal Date Picker Styles (matching index.wxss) */
.date-scroll {
  display: flex;
  white-space: nowrap;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f5f5f4;
  border-radius: 16rpx;
  margin-right: 14rpx;
  min-width: 90rpx;
}

.date-item.active {
  background: #78350f;
  color: #fff;
}

.date-rel {
  font-size: 20rpx;
}

.date-num {
  font-size: 32rpx;
  font-weight: bold;
  margin: 4rpx 0;
}

.date-week {
  font-size: 20rpx;
}

.batch-btns {
  display: flex;
  gap: 16rpx;
}

.batch-btn {
  flex: 1;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.batch-btn.open {
  background: #ecfdf5;
  color: #065f46;
  border: 1rpx solid #a7f3d0;
}

.batch-btn.rest {
  background: #fef2f2;
  color: #991b1b;
  border: 1rpx solid #fecaca;
}

.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.slot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e7e5e4;
  background: #fff;
}

.slot-row.available {
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.slot-row.unavailable {
  background: #fafaf9;
  border-color: #e7e5e4;
}

.slot-row.booked {
  background: #f0f9ff;
  border-color: #bae6fd;
}

.time-col {
  font-size: 28rpx;
  font-weight: bold;
  font-family: monospace;
  width: 120rpx;
}

.status-col {
  flex: 1;
  font-size: 24rpx;
}

.tag-avail {
  color: #059669;
  font-weight: bold;
}

.tag-unavail {
  color: #78716c;
}

.tag-booked {
  color: #0369a1;
  font-weight: bold;
}

.toggle-btn {
  font-size: 20rpx;
  background: #fff;
  border: 1rpx solid #d6d3d1;
}
